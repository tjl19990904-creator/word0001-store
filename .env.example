NODE_ENV=production
PORT=3000
SESSION_SECRET=word0001-store-secret-key-2026-change-this
STRIPE_MODE=live
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_2D_ONLY=true
# Apple Pay is a card wallet (shown with `card` after domain verification).
# Link is a separate method and is enabled on the hosted Checkout page by default.
# Set to false only if the Stripe account does not have Link enabled.
STRIPE_LINK_ENABLED=true
