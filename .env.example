NODE_ENV=production
PORT=3000
SESSION_SECRET=word0001-store-secret-key-2026-change-this
STRIPE_MODE=live
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_2D_ONLY=true
# Stripe Checkout uses DYNAMIC payment methods by default: leave this unset and
# Stripe shows every method enabled in the Dashboard (Link, Apple Pay, card...).
# Enable Link / Apple Pay in Stripe Dashboard > Settings > Payment methods, and
# verify the domain for Apple Pay. Only pin a list if the integration requires it,
# e.g. STRIPE_CHECKOUT_METHODS=card,link
# STRIPE_CHECKOUT_METHODS=
# Payment Links (buy.stripe.com) show an editable-looking amount box locked to
# the server price. Set false to hide the amount box entirely.
STRIPE_PAYMENT_LINK_CUSTOM_AMOUNT=true
